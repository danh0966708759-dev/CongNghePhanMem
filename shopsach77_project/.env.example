# PHP reads these from the Apache environment. Otherwise, edit php/db.php.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=shop_sach_77project

# Read by php/setup_admin.php when creating the admin account from the CLI.
ADMIN_NAME=Quản trị viên Shop
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Optional exact origins for a separate frontend/API host. Same-origin XAMPP needs none.
FRONTEND_ORIGIN=
